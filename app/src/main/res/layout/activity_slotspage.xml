<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_slotspage">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Booking System"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/availableRoom1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/rectanglecontainer"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Number 1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/availability1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 - 18:00"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/bookRoomButton1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Book"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/availableRoom2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/rectanglecontainer"
        app:layout_constraintTop_toBottomOf="@+id/availableRoom1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomNumber2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Number 2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/availability2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 - 12:00"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/bookRoomButton2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Book"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/availableRoom3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/rectanglecontainer"
        app:layout_constraintTop_toBottomOf="@+id/availableRoom2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomNumber3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Number 3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/availability3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:00 - 18:00"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/bookRoomButton3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Book"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/availableRoom4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/rectanglecontainer"
        app:layout_constraintTop_toBottomOf="@+id/availableRoom3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/roomNumber4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Number 4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/availability4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00 - 22:00"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/bookRoomButton4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Book"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hotbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/calendarNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/calendaricon"
            android:contentDescription="calendar screen button" />

        <ImageButton
            android:id="@+id/historyNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/historyicon"
            android:contentDescription="history screen button" />

        <ImageButton
            android:id="@+id/profileNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/profileicon"
            android:contentDescription="profile screen button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>